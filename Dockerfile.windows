# syntax=docker/dockerfile:1
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all
ENV WINEPREFIX=/root/.wine

# 1. WineHQ resmi reposunu ekle ve güncel Wine'ı kur
RUN dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg2 \
    && mkdir -pm755 /etc/apt/keyrings \
    && curl -sSL https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key \
    && curl -sSL -o /etc/apt/sources.list.d/winehq-jammy.sources https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources \
    && apt-get update && apt-get install -y --install-recommends \
    winehq-stable \
    && rm -rf /var/lib/apt/lists/*

# 2. Wine ortamını ilklendir ve Windows 10 moduna ayarla
RUN wineboot --init && wineserver -w && \
    wine reg add "HKEY_CURRENT_USER\\Software\\Wine" /v Version /t REG_SZ /d win10 /f && \
    wineserver -w

# 3. Tam Windows Python 3.10 Yükleyicisini (Tcl/Tk ve pip dahil) Kur
WORKDIR /tmp
RUN curl -sSL -o python-installer.exe https://www.python.org/ftp/python/3.10.11/python-3.10.11-amd64.exe && \
    wine python-installer.exe /quiet InstallAllUsers=1 PrependPath=1 TargetDir=C:\\Python310 Include_tcltk=1 Include_pip=1 Include_test=0 && \
    wineserver -w && \
    rm python-installer.exe

# 4. Bağımlılıklar ve PyInstaller kurulumu
WORKDIR /src
COPY requirements.txt .
RUN wine C:\\Python310\\python.exe -m pip install --no-warn-script-location --upgrade pip && \
    wine C:\\Python310\\python.exe -m pip install --no-warn-script-location pyinstaller && \
    wine C:\\Python310\\python.exe -m pip install --no-warn-script-location -r requirements.txt && \
    wineserver -w

# 5. Proje kodlarını kopyala ve derle
COPY . .
RUN wine C:\\Python310\\python.exe -m PyInstaller --clean --noconfirm main2.spec && \
    wine C:\\Python310\\python.exe -m PyInstaller --clean --noconfirm --noconsole --onefile --distpath /src/dist/main2 updater.py && \
    wineserver -w

# 6. Çıktıyı dışarı aktarma katmanı
FROM scratch AS export
COPY --from=builder /src/dist/ /